PUBLIC_BASE_URL=https://your-domain.example
TELEPHONY_PROVIDER=exotel
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=
EXOTEL_WS_TOKEN=
IVR_TIMEOUT_SECONDS=8
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=+91XXXXXXXXXX
SARVAM_API_KEY=
SARVAM_SPEAKER=
DATABASE_URL=postgresql://hv:hv@db:5432/hv
REDIS_URL=redis://redis:6379/0
DEFAULT_LANGUAGE=hi-IN
# Languages in the menu at the start of the call (key 1 Hindi, 2 English, 3 Marathi)
LANGUAGES=hi-IN,en-IN,mr-IN
PHONE_HASH_SECRET=
PHONE_ENC_KEY=
CALLBACK_DELAY_SECONDS=5
MAX_TRIGGERS_PER_DAY=3
DAILY_CALL_BUDGET=100
QUIET_HOURS=21:00-09:00
CALLS_PAGE_USER=admin
CALLS_PAGE_PASSWORD=
VAD_THRESHOLD=500
RECORD_SILENCE_SECONDS=2.5
RECORD_NO_SPEECH_SECONDS=12
# longest wait for the worker's answer during a call ("please stay on the line" meanwhile)
STORY_MAX_WAIT_SECONDS=90
# answer review and the closing (reference number + documents); true or false
REVIEW_ANSWERS=true
CLOSING_DETAILS=true
# Sarvam's LLM also reads the work story (India-hosted); false turns it off
LLM_ENABLED=true
SARVAM_LLM_MODEL=sarvam-105b-conversations
LLM_TIMEOUT_SECONDS=12
# only on the server in India (docs/DEPLOY.md): the domain Caddy serves with HTTPS
DOMAIN=
