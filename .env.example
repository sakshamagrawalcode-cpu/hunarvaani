# INSTALL.bat writes this file for you (.env). Edit it to change settings, then restart RUN.bat.

# real = local models (Ollama LLM + IndicConformer speech-to-text); fake = no models, screens only
HV_MODELS=fake

# LLM served by Ollama on this laptop. 8 GB GPU (RTX 5050): gemma4:e4b-it-qat; if slow: gemma4:e2b-it-qat
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:e4b-it-qat
LLM_CTX=8192

# Speech-to-text device: cpu leaves the GPU to the LLM (right for 8 GB). cuda needs onnxruntime-gpu.
STT_DEVICE=cpu

# Location "per device": each kiosk sets its own PIN code once on its screen (kiosk page, "change").
# DEVICE_PINCODE is the default for kiosks that have not; PHONE_PINCODE is the phone line's area.
# If neither is set, the person is asked for their PIN code on the keypad.
DEVICE_PINCODE=
PHONE_PINCODE=

# Officer console login (the installer sets a random password)
OFFICER_USER=officer
OFFICER_PASSWORD=change-me

# Secret part of the Exotel Voicebot URL: wss://<your-public-host>/exotel/ws/<EXOTEL_WS_TOKEN>
EXOTEL_WS_TOKEN=change-me-to-a-long-random-string

# Phone speech capture: raise VAD_THRESHOLD if background noise is cut in as speech
VAD_THRESHOLD=500
SILENCE_SECONDS=1.6
MAX_OPTIONS=5
